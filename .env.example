# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.
# Variabel Vite harus berawalan VITE_ dan akan terlihat di sisi browser,
# jadi jangan isi dengan secret apa pun.

# URL API server NoxFlix (noxflix-movie-server), lengkap dengan prefix /api/v1
# Lokal      : http://localhost:8081/api/v1/
# Production : https://<nama-server-kamu>.vercel.app/api/v1/
VITE_REACT_APP_BASEURL=http://localhost:8081/api/v1/
